@article{Gieseke:2003rz,
  title = {New Formalism for {{QCD}} Parton Showers},
  author = {Gieseke, Stefan and Stephens, P. and Webber, Bryan},
  date = {2003},
  journaltitle = {Journal of High Energy Physics},
  shortjournal = {J. High Energy Phys.},
  volume = {12},
  number = {12},
