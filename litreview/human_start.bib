@article{Dokshitzer:1978dr,
  title = {Hard Semiinclusive Processes in {{QCD}}},
  author = {family=Dokshitzer, given=Yu. L., given-i={{Yu}}L and D'yakonov, D. I. and Troyan, S. I.},
  date = {1978},
  journaltitle = {Physics Letters B},
  shortjournal = {Phys. Lett. B},
  volume = {78},
  number = {2},
  pages = {290--294},
  issn = {0370-2693},
  doi = {10.1016/0370-2693(78)90025-4},
  url = {https://www.sciencedirect.com/science/article/pii/0370269378900254},
  urldate = {2026-10-28},
  abstract = {We present formulae resulting from a complete perturbative analysis of differential cross sections of (i) massive lepton pair production in hadron collisions, (ii) leptoproduction of a particle from the current fragmentation region, (iii) production of two particles from opposite jets in e + e − annihilation into hadrons. A new effective double logarithmic quark form factor is derived, which manifests itself in these processes. Experimental investigation of two-particle angle correlations in e + e − annihilation provides a possibility to measure directly this form factor and thus to make a nice test of QCD.},
  langid = {english},
  file = {C\:\\Users\\simon\\Zotero\\storage\\QU6J4VSD\\Dokshitzer et al. - 1978 - Hard semiinclusive processes in QCD.pdf;C\:\\Users\\simon\\Zotero\\storage\\4BRAI9D4\\0370269378900254.html}
}

@article{dokshitzerQCDCoherenceHighenergy1988,
  title = {{{QCD}} Coherence in High-Energy Reactions},
  author = {family=Dokshitzer, given=Yu. L., given-i={{Yu}}L and Khoze, V. A. and Troyan, S. I. and Mueller, A. H.},
  date = {1988-04-01},
  journaltitle = {Reviews of Modern Physics},
  shortjournal = {Rev. Mod. Phys.},
  volume = {60},
  number = {2},
  pages = {373--388},
  publisher = {American Physical Society},
  issn = {0034-6861},
  doi = {10.1103/RevModPhys.60.373},
  url = {https://link.aps.org/doi/10.1103/RevModPhys.60.373},
  urldate = {2026-10-20},
  abstract = {The authors review the ideas and manifestations of QCD coherence in high-energy reactions producing jets. They suggest experiments involving two-jet production, high-𝑝⊥⁢𝛾 production and high-𝑝⊥⁢𝑊 production at hadronic colliders as ways to see QCD coherence in stringlike effects. They also suggest a procedure for finding the dip in the inclusive hadron spectrum of jets for those jets produced at hadron colliders. Simple explanations of the various coherence effects in QCD are discussed, as is the idea of local parton-hadron duality.},
  langid = {english},
  file = {C\:\\Users\\simon\\Zotero\\storage\\LMZDTTJU\\Dokshitzer et al. - 1988 - QCD coherence in high-energy reactions.pdf;C\:\\Users\\simon\\Zotero\\storage\\FWPZRGF5\\RevModPhys.60.html}
}

