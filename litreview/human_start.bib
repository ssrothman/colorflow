@article{argyropoulosEffectsColorReconnection2014,
  title = {Effects of Color Reconnection on \$t\textbackslash bar\{t\}\$ Final States at the {{LHC}}},
  author = {Argyropoulos, Spyros and Sjöstrand, Torbjörn},
  date = {2014-11},
  journaltitle = {Journal of High Energy Physics},
  shortjournal = {J. High Energ. Phys.},
  volume = {2014},
  number = {11},
  eprint = {1407.6653},
  eprinttype = {arXiv},
  eprintclass = {hep-ph},
  pages = {43},
  issn = {1029-8479},
  doi = {10.1007/JHEP11(2014)043},
  url = {http://arxiv.org/abs/1407.6653},
  urldate = {2026-07-16},
  abstract = {The modeling of color reconnection has become one of the dominant sources of systematic uncertainty in the top mass determination at hadron colliders. The uncertainty on the top mass due to color reconnection is conventionally estimated by taking the difference in the predictions of a model with and a model without color reconnection. We show that this procedure underestimates the uncertainty when applied to the existing models in \{\textbackslash sc Pythia\}\textasciitilde 8. We introduce two new classes of color reconnection models, each containing several variants, which encompass a variety of scenarios that could be realized in nature and we study how they affect the reconstruction of the top mass. After tuning the new models to existing LHC data, the remaining spread of predictions is used to derive a more realistic uncertainty for the top mass, which is found to be around 500 MeV. We also propose how future LHC measurements with \$t\textbackslash bar\{t\}\$ events can be used to further constrain these models and reduce the associated modeling uncertainty.},
  langid = {english},
  file = {C\:\\Users\\simon\\Zotero\\storage\\3APLIMLL\\Argyropoulos and Sjöstrand - 2014 - Effects of color reconnection on $tbar t $ final states at the LHC.pdf;C\:\\Users\\simon\\Zotero\\storage\\WPPBGQQW\\1407.html}
}

@report{ATLASPythia82014,
  title = {{{ATLAS}} Pythia 8 Tunes to 7 {{TeV}} Data},
  date = {2014-11-02},
  journaltitle = {CERN Document Server},
  institution = {ATL-COM-PHYS-2014-1337},
  url = {https://cds.cern.ch/record/1966419},
  urldate = {2026-10-19},
  abstract = {We present tunes of the Pythia8 Monte\textasciitilde Carlo event generator's parton shower and multiple parton interaction parameters to a range of data observables from ATLAS Run 1. Four new tunes have been constructed, corresponding to the four leading-order parton density functions, CTEQ6L1, MSTW2008LO, NNPDF23LO, and HERAPDF15LO, each simultaneously tuning ten generator parameters. A set of systematic variations is provided for the NNPDF tune, based on the eigentune method. These tunes improve the modeling of observables that can be described by leading-order + parton shower simulation, and are primarily intended for use in situations where next-to-leading-order and/or multileg parton-showered simulations are unavailable or impractical.},
  eid = {ATL-PHYS-PUB-2014-021},
  langid = {english},
  keywords = {MetadataHunter: No DOI},
  file = {C:\Users\simon\Zotero\storage\UC5DLWPY\2014 - ATLAS pythia 8 tunes to 7 TeV data.pdf}
}

@article{bahrHerwigPhysicsManual2008,
  title = {Herwig++ {{Physics}} and {{Manual}}},
  author = {Bahr, M. and Gieseke, S. and Gigg, M. A. and Grellscheid, D. and Hamilton, K. and Latunde-Dada, O. and Platzer, S. and Richardson, P. and Seymour, M. H. and Sherstnev, A. and Tully, J. and Webber, B. R.},
  date = {2008-12},
  journaltitle = {The European Physical Journal C},
  shortjournal = {Eur. Phys. J. C},
  volume = {58},
  number = {4},
  eprint = {0803.0883},
  eprinttype = {arXiv},
  eprintclass = {hep-ph},
  pages = {639--707},
  issn = {1434-6044, 1434-6052},
  doi = {10.1140/epjc/s10052-008-0798-9},
  url = {http://arxiv.org/abs/0803.0883},
  urldate = {2026-07-16},
  abstract = {In this paper we describe Herwig++ version 2.3, a general-purpose Monte Carlo event generator for the simulation of hard lepton-lepton, lepton-hadron and hadron-hadron collisions. A number of important hard scattering processes are available, together with an interface via the Les Houches Accord to specialized matrix element generators for additional processes. The simulation of Beyond the Standard Model (BSM) physics includes a range of models and allows new models to be added by encoding the Feynman rules of the model. The parton-shower approach is used to simulate initial- and final-state QCD radiation, including colour coherence effects, with special emphasis on the correct description of radiation from heavy particles. The underlying event is simulated using an eikonal multiple parton-parton scattering model. The formation of hadrons from the quarks and gluons produced in the parton shower is described using the cluster hadronization model. Hadron decays are simulated using matrix elements, where possible including spin correlations and off-shell effects.},
  langid = {english},
  file = {C\:\\Users\\simon\\Zotero\\storage\\TUJGLXV4\\Bahr et al. - 2008 - Herwig++ Physics and Manual.pdf;C\:\\Users\\simon\\Zotero\\storage\\EVV9VFSE\\0803.html}
}

@article{bartelParticleDistribution3jet1983,
  title = {Particle Distribution in 3-Jet Events Produced Bye-e--Annihilation},
  author = {Bartel, W. and Becker, L. and Bowdery, C. and Cords, D. and Eichler, R. and Felst, R. and Haidt, D. and Krehbiel, H. and Naroska, B. and Olsson, J. and Steffen, P. and Warming, P. and Dietrich, G. and Elsen, E. and Heinzelmann, G. and Kado, H. and Meier, K. and Petersen, A. and Schneekloth, U. and Weber, G. and Bethke, S. and Dieckmann, A. and Heintze, J. and Hellenbrand, K. H. and Heuer, R. D. and Komamiya, S. and family=Krogh, given=J., prefix=von, useprefix=true and Lennert, P. and Matsumura, H. and Rieseberg, H. and Spitzer, J. and Wagner, A. and Bell, A. and Finch, A. and Foster, F. and Hughes, G. and Nozaki, T. and Wriedt, H. and Allison, J. and Baines, J. and Ball, A. H. and Barlow, R. J. and Chrin, J. and Duerdoth, I. P. and Glendinning, I. and Loebinger, F. K. and Macbeth, A. A. and McCann, H. and Mills, H. E. and Murphy, P. G. and Rowe, P. G. and Stephens, K. and Clarke, D. and Marshall, R. and Pearce, G. F. and Whittaker, J. B. and Kanzaki, J. and Kawamoto, T. and Kobayashi, T. and Koshiba, M. and Minowa, M. and Nozaki, M. and Odaka, S. and Orito, S. and Sato, A. and Takeda, H. and Takeshita, T. and Totsuka, Y. and Yamada, S. and {Jade Collaboration}},
  date = {1983-03-01},
  journaltitle = {Zeitschrift für Physik C: Particles and Fields},
  shortjournal = {Z. Phys. C: Part. Fields},
  volume = {21},
  number = {1},
  pages = {37--52},
  issn = {1431-5858},
  doi = {10.1007/BF01648774},
  url = {https://doi.org/10.1007/BF01648774},
  urldate = {2026-10-20},
  abstract = {We have studied the distribution of particles within and between jets of 3-jet final states produced in the reactione+e−→hadrons at c.m. energies of 22 GeV and 29–36.4 GeV. The lowest energy jet shows distributions of transverse momenta, particle flow, and energy flow which differ significantly from those of the other two jets and from jets of 2-jet events atEcm=14 GeV. First order QCD calculations with subsequent fragmentation of quarks and gluons into hadrons indicate that the lowest energy jet has the largest probability of originating from a gluon. To reproduce the observed differences in an independent parton fragmentation model, the secondary quarks of a gluon jet have to have higher transverse momenta and lower parallel momenta than those of a quark jet. The particle densities between the jets as well as the correlation of transverse and longitudinal momenta of the particles within the jets favour models with fragmentation along the colour axes.},
  langid = {english},
  keywords = {Energy Flow,Fragmentation Model,Large Probability,MetadataHunter: No Richer Record,Particle Acceleration,Transverse Momentum},
  file = {C:\Users\simon\Zotero\storage\NWZEYGFD\Bartel et al. - 1983 - Particle distribution in 3-jet events produced bye-e--annihilation.pdf}
}

