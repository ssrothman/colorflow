{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
        "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)",
        "Bash(grep:*)", "Bash(awk:*)", "Bash(sed:*)", "Bash(cut:*)", "Bash(sort:*)",
        "Bash(find:*)", "Bash(stat:*)", "Bash(cmp:*)", "Bash(diff:*)",
        "Bash(pdftotext:*)", "Bash(pdfinfo:*)", "Bash(cat:*)",
        "Bash(python3 .claude/skills/literature-review/scripts/lr.py:*)",
        "Bash(python3 .claude/skills/literature-review/scripts/test_lr.py:*)",
        "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)"
    ]  
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "inspirehep.net", "arxiv.org", "export.arxiv.org", "api.openalex.org",
        "www.hepdata.net", "hepdata.net", "cds.cern.ch", "repo.scoap3.org"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [{
      "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep",
      "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/path_guard.py" }]
    }]
  }
}
